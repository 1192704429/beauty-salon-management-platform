<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.beauty.api.dao.ItemsDao">

    <select id="findList" parameterType="com.beauty.api.dto.ItemsDTO" resultType="com.beauty.api.dto.ItemsDTO">
        select
        items.*
        from items items
        <where>
            <if test="id != null and id != ''">and items.id = #{id}</if>
            <if test="name != null and name != ''">and items.name like concat('%',#{name},'%')</if>
            <if test="stock != null and stock != ''">and items.stock = #{stock}</if>
            <if test="img != null and img != ''">and items.img = #{img}</if>
            <if test="createTime != null and createTime != ''">and items.create_time = #{createTime}</if>
        </where>
        <if test="current != null and pageSize != null">
            limit #{current},#{pageSize}
        </if>
    </select>

    <select id="findPageCount" parameterType="com.beauty.api.dto.ItemsDTO" resultType="java.lang.Integer">
        select count(*) from items items
        <where>
            <if test="id != null and id != ''">and items.id = #{id}</if>
            <if test="name != null and name != ''">and items.name like concat('%',#{name},'%')</if>
            <if test="stock != null and stock != ''">and items.stock = #{stock}</if>
            <if test="img != null and img != ''">and items.img = #{img}</if>
            <if test="createTime != null and createTime != ''">and items.create_time = #{createTime}</if>
        </where>
    </select>

</mapper>

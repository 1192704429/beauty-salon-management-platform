<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.beauty.api.dao.BannerDao">

    <select id="findList" parameterType="com.beauty.api.dto.BannerDTO" resultType="com.beauty.api.dto.BannerDTO">
        select
        banner.*
        from banner banner
        <where>
            <if test="id != null and id != ''">and banner.id = #{id}</if>
            <if test="bannerImg != null and bannerImg != ''">and banner.banner_img = #{bannerImg}</if>
            <if test="status != null and status != ''">and banner.status = #{status}</if>
            <if test="createTime != null and createTime != ''">and banner.create_time = #{createTime}</if>
        </where>
        <if test="current != null and pageSize != null">
            limit #{current},#{pageSize}
        </if>
    </select>

    <select id="findPageCount" parameterType="com.beauty.api.dto.BannerDTO" resultType="java.lang.Integer">
        select count(*) from banner banner
        <where>
            <if test="id != null and id != ''">and banner.id = #{id}</if>
            <if test="bannerImg != null and bannerImg != ''">and banner.banner_img = #{bannerImg}</if>
            <if test="status != null and status != ''">and banner.status = #{status}</if>
            <if test="createTime != null and createTime != ''">and banner.create_time = #{createTime}</if>
        </where>
    </select>

</mapper>
